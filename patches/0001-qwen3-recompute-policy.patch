+"""Declare the Qwen3 dense recompute regions used by normal training."""
+
+from hyper_parallel.models.adapter_spec import RecomputePolicy
+
+
+def build_recompute_policy() -> RecomputePolicy:
+    """Return the Qwen3 safe recompute regions.
+
+    Every decoder layer is one region: the pattern matches the layer itself, so
+    a selected layer keeps a single saved copy of its input and replays the
+    whole layer. Qwen3 dense has no cross-layer state producer or consumer and
+    no non-decoder execution branch, so nothing is excluded and no runtime hook
+    is needed.
+    """
+    return RecomputePolicy(region_patterns=("model.layers.*",))
+
+
+__all__ = ["build_recompute_policy"]
diff --git a/hyper_parallel/models/qwen3/adapter/registration.py b/hyper_parallel/models/qwen3/adapter/registration.py
index 847e441e..3693a0b2 100644
--- a/hyper_parallel/models/qwen3/adapter/registration.py
+++ b/hyper_parallel/models/qwen3/adapter/registration.py
@@ -39,12 +39,22 @@ def _load_attention():
     return attention
 
 
+def _load_recompute():
+    """Return the Qwen3 recompute policy through a lazy provider."""
+    from hyper_parallel.models.qwen3.adapter.policies.activation_checkpointing import (  # pylint: disable=C0415
+        build_recompute_policy,
+    )
+
+    return build_recompute_policy()
+
+
 QWEN3_ADAPTER_SPEC = ModelAdapterSpec(
     architecture="Qwen3ForCausalLM",
     model_type="qwen3",
     replacements=_load_replacements,
     attention=_load_attention,
     sharding_rules=build_parameter_sharding_rules,
+    recompute=_load_recompute,
 )
 
 register_model_adapter(QWEN3_ADAPTER_SPEC)
