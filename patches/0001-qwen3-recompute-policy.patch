+"""Pin the Qwen3 recompute-policy declaration used by layer selection.
+
+Gate-1 test: no NPU, no process group, no model build. It pins the adapter
+declaration that unlocks ``selection.source=model_adapter_safe_regions`` for
+Qwen3 dense models, where every decoder layer is one safe recompute region.
+"""
+
+import unittest
+
+from hyper_parallel.models.adapter_spec import RecomputePolicy
+from hyper_parallel.models.qwen3.adapter.policies.activation_checkpointing import (
+    build_recompute_policy,
+)
+from hyper_parallel.models.registry import get_model_adapter
+
+
+class Qwen3RecomputePolicyTest(unittest.TestCase):
+    def test_policy_declares_one_region_per_decoder_layer(self):
+        policy = build_recompute_policy()
+        self.assertIsInstance(policy, RecomputePolicy)
+        self.assertEqual(policy.region_patterns, ("model.layers.*",))
+        self.assertEqual(policy.exclude_patterns, ())
+        self.assertIsNone(policy.exclude_predicate)
+        self.assertIsNone(policy.on_applied)
+
+    def test_qwen3_adapter_registers_the_recompute_provider(self):
+        spec = get_model_adapter("qwen3")
+        self.assertIsNotNone(spec)
+        self.assertTrue(callable(spec.recompute))
+        self.assertIsInstance(spec.recompute(), RecomputePolicy)
+
+
+if __name__ == "__main__":
+    unittest.main()
