{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experiment-record/v1",
  "title": "Experiment Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "record_id",
    "record_type",
    "workflow",
    "experiment_id",
    "created_at",
    "source",
    "workload",
    "gate",
    "decision",
    "evidence",
    "step"
  ],
  "properties": {
    "schema": {
      "const": "experiment-record/v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "record_type": {
      "enum": ["baseline", "candidate", "confirmation", "recovery"]
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_id": {
      "type": ["string", "null"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "digest", "dirty"],
      "properties": {
        "revision": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "minLength": 1},
        "dirty": {"type": "boolean"}
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "hash"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "hash": {"type": "string", "minLength": 1}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "SKIP"]},
        "first_failure": {"type": ["string", "null"]},
        "evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "metrics": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "reason"],
      "properties": {
        "value": {
          "enum": ["keep", "discard", "crash", "pending", "accepted", "rejected", "invalid"]
        },
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "minLength": 64}
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["why", "changes", "test_result", "commit"],
      "properties": {
        "why": {
          "type": "string",
          "minLength": 1
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "test_result": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit_ref", "docs_included", "code_restored"],
          "properties": {
            "commit_ref": {
              "type": "string",
              "minLength": 1,
              "description": "Commit hash or the stable Experiment-Record trailer used to resolve it."
            },
            "docs_included": {"const": true},
            "code_restored": {"type": "boolean"},
            "rollback_ref": {"type": ["string", "null"]}
          },
          "allOf": [
            {
              "if": {
                "properties": {"code_restored": {"const": true}},
                "required": ["code_restored"]
              },
              "then": {
                "required": ["rollback_ref"],
                "properties": {"rollback_ref": {"type": "string", "minLength": 1}}
              }
            },
            {
              "if": {
                "properties": {"code_restored": {"const": false}},
                "required": ["code_restored"]
              },
              "then": {"properties": {"rollback_ref": {"type": "null"}}}
            }
          ]
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {"properties": {"value": {"enum": ["keep", "accepted"]}}}
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "step": {
            "properties": {
              "commit": {"properties": {"code_restored": {"const": false}}}
            }
          }
        }
      }
    }
  ]
}
